# Supabase (§2.6/§2.7) — from Project Settings > API and > Database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supavisor pooled connection string, session mode, port 5432 — used by Drizzle/drizzle-kit
DATABASE_URL=

# Public origin used to build Supabase auth email links (confirm signup, etc.).
# Optional on Vercel — falls back to VERCEL_PROJECT_PRODUCTION_URL, then the
# request's own host. Set it explicitly once a custom domain is in play.
# Whatever this resolves to, "<origin>/auth/callback" MUST be listed under
# Supabase > Authentication > URL Configuration > Redirect URLs, or Supabase
# silently ignores it and falls back to the dashboard "Site URL".
NEXT_PUBLIC_SITE_URL=

# Cloudflare R2 (§2.6) — VietSmart file storage, zero egress
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# AI provider abstraction (§2.10, D4) — default free-tier model
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
# Comma-separated — supports multiple keys, rotated on rate-limit/timeout
GEMINI_API_KEYS=
# Optional paid upgrade path (D4) — never required
ANTHROPIC_API_KEY=
